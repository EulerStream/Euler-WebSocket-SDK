{
  "name": "@eulerstream/euler-websocket-sdk",
  "version": "1.0.0",
  "description": "Browser & Node.JS cross-compatible module for the Euler Stream WebSocket service.",
  "main": "./dist/node/index.js",
  "types": "./dist/node/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/web/index.d.ts",
        "default": "./dist/web/index.js"
      },
      "import": {
        "types": "./dist/node/index.d.ts",
        "default": "./dist/node/index.js"
      }
    },
    "./v1": {
      "browser": {
        "types": "./dist/web/v1.d.ts",
        "default": "./dist/web/v1.js"
      },
      "import": {
        "types": "./dist/node/v1.d.ts",
        "default": "./dist/node/v1.js"
      }
    },
    "./v2": {
      "browser": {
        "types": "./dist/web/v2.d.ts",
        "default": "./dist/web/v2.js"
      },
      "import": {
        "types": "./dist/node/v2.d.ts",
        "default": "./dist/node/v2.js"
      }
    },
    "./v3": {
      "browser": {
        "types": "./dist/web/v3.d.ts",
        "default": "./dist/web/v3.js"
      },
      "import": {
        "types": "./dist/node/v3.d.ts",
        "default": "./dist/node/v3.js"
      }
    },
    "./client/schemas": {
      "browser": {
        "types": "./dist/web/client/schemas.d.ts",
        "default": "./dist/web/client/schemas.js"
      },
      "import": {
        "types": "./dist/node/client/schemas.d.ts",
        "default": "./dist/node/client/schemas.js"
      }
    }
  },
  "scripts": {
    "build": "pnpm run generate:schemas && tsdown --config-loader unconfig",
    "clean": "rm -rf dist tmp",
    "generate": "pnpm run generate:schemas",
    "generate:schemas": "tsx ./scripts/generate-client-schemas.mts",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EulerStream/Euler-WebSocket-SDK"
  },
  "keywords": [
    "tiktok",
    "tiktok live",
    "tiktok.com",
    "live",
    "stream",
    "livestream",
    "chat",
    "connector",
    "api",
    "webcast",
    "tracker",
    "scraper",
    "websocket",
    "bot",
    "broadcast",
    "reader"
  ],
  "author": "eulerstream",
  "license": "MIT",
  "homepage": "https://github.com/EulerStream/Euler-WebSocket-SDK",
  "dependencies": {
    "@bufbuild/protobuf": "^2.4.0",
    "eventemitter3": "^5.0.1",
    "fflate": "^0.8.2",
    "tiktok-live-proto-full-types": "0.0.1",
    "zod": "^3.25.34"
  },
  "devDependencies": {
    "@babel/cli": "^7.17.0",
    "@babel/core": "^7.17.2",
    "@babel/preset-env": "^7.16.11",
    "@types/node": "^22.15.3",
    "child_process": "^1.0.2",
    "dotenv": "^16.5.0",
    "prettier": "2.5.1",
    "readline": "^1.3.0",
    "ts-proto": "^2.11.6",
    "tsdown": "^0.21.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2"
  }
}
